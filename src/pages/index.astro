---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Downloader from "../components/Downloader.astro";
import TrustBadges from "../components/TrustBadges.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FAQ from "../components/FAQ.astro";
import { platforms } from "../data/platforms";
---

<BaseLayout
  title="Descarga Script: descargar Scribd y Studocu gratis"
  description="Descarga Script: pega el enlace y descarga de Scribd, Studocu o SlideShare sin registro. Hub para bajar script / descargar script online en PDF."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Descarga Script",
      url: "https://descargarscript.com/",
      description:
        "Descarga Script: pega el enlace y descarga de Scribd, Studocu o SlideShare sin registro. Hub para bajar script / descargar script online en PDF.",
      inLanguage: "es",
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      name: "Descarga Script",
      url: "https://descargarscript.com/",
      logo: "https://descargarscript.com/web-app-manifest-512x512.png",
      email: "contact@descargarscript.com",
    },
  ]}
>
  <SiteHeader />

  <main>
    <section class="py-16 sm:py-24 px-6">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 tracking-tight leading-tight">
          Descarga Script
        </h1>
        <p class="mt-5 text-lg text-slate-500 leading-relaxed">
          <strong>Descargar script</strong> / bajar script online: pega el enlace y guarda el archivo.
          Elige la plataforma abajo — Scribd, Studocu, SlideShare o PDF — para no mezclar la intención de búsqueda.
        </p>
      </div>
    </section>

    <Downloader placeholder="Pega el enlace de Scribd, SlideShare o Studocu..." />

    <div class="px-6 pb-10">
      <div class="flex flex-wrap items-center justify-center gap-3 text-sm text-slate-500">
        {
          platforms.map((p) => (
            <a
              href={p.href}
              class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 hover:bg-blue-50 hover:text-blue-700 transition-colors"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
              {p.name}
            </a>
          ))
        }
      </div>
    </div>

    <TrustBadges />
    <HowItWorks />

    <section id="plataformas" class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-900 text-center mb-3">Elige la plataforma (hub Descarga Script)</h2>
        <p class="text-center text-sm text-slate-500 max-w-2xl mx-auto mb-10">
          La portada responde a <strong>descargar script</strong> / bajar script.
          Si buscas una plataforma concreta, entra a su página para alinear Title e intención:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {
            platforms.map((p) => (
              <a
                href={p.href}
                class="bg-white rounded-xl border border-slate-200 p-5 text-center hover:border-blue-300 hover:shadow-sm transition-all"
              >
                <div class="text-2xl mb-2">{p.emoji}</div>
                <p class="font-medium text-slate-900 text-sm">{p.name}</p>
                <p class="text-xs text-slate-500 mt-1">{p.blurb}</p>
              </a>
            ))
          }
        </div>
        <div class="mt-6 text-center">
          <a
            href="/como-descargar-scribd-gratis/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 bg-white text-sm font-medium text-slate-800 hover:border-blue-300 hover:text-blue-700 transition-colors"
          >
            Guía: cómo descargar Scribd gratis →
          </a>
          <p class="mt-2 text-xs text-slate-400">
            La herramienta (pegar enlace) está en
            <a href="/scribd" class="text-blue-600 hover:underline">/scribd</a>;
            la guía explica el método y los límites.
          </p>
        </div>
      </div>
    </section>

    <FAQ />

    <section class="py-16 px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-2xl font-bold text-slate-900 mb-4">Qué es Descarga Script</h2>
        <div class="text-slate-600 text-sm leading-relaxed space-y-4">
          <p>
            <strong>Descarga Script</strong> es la herramienta de
            <a href="/" class="text-blue-600 hover:underline">descargarscript.com</a>
            para descargar documentos sin cuenta. Si buscaste descargar script, script gratis o descargar documentos de script, es este sitio: pegas un enlace y guardas el archivo.
          </p>
          <p>
            Sirve para
            <a href="/scribd" class="text-blue-600 hover:underline">descargar Scribd gratis</a>,
            <a href="/slideshare" class="text-blue-600 hover:underline">SlideShare (PDF/PPT)</a>
            y
            <a href="/studocu" class="text-blue-600 hover:underline">Studocu sin subir documentos</a>.
            El resultado habitual es un
            <a href="/pdf" class="text-blue-600 hover:underline">PDF desde la plataforma</a>.
            Si buscas los pasos (no el cuadro), lee
            <a href="/como-descargar-scribd-gratis/" class="text-blue-600 hover:underline">cómo descargar Scribd gratis</a>.
            La intención corta «descargar Scribd gratis» la atiende mejor
            <a href="/scribd" class="text-blue-600 hover:underline">la página de Scribd</a>,
            no esta portada de marca.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
