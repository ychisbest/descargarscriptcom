---
interface Props {
  placeholder?: string;
}

const {
  placeholder = "Pega el enlace de Scribd, SlideShare o Studocu...",
} = Astro.props;
---

<section class="px-6 pb-6">
  <div class="max-w-xl mx-auto">
    <div class="flex flex-col sm:flex-row gap-3">
      <input
        type="url"
        id="url-input"
        placeholder={placeholder}
        class="flex-1 px-5 py-3.5 rounded-xl border border-slate-300 bg-white text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-shadow text-base"
      />
      <button
        id="download-btn"
        class="px-8 py-3.5 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700 active:bg-blue-800 transition-colors text-base whitespace-nowrap"
      >
        Descargar
      </button>
    </div>
    <p id="error-msg" class="mt-3 text-sm text-red-500 hidden">
      Por favor, ingresa un enlace válido de Scribd, SlideShare o Studocu.
    </p>
  </div>
</section>

<section id="studocu-preview" class="pb-16 px-6 hidden">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 bg-slate-50">
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <span id="studocu-title">Procesando documento de Studocu...</span>
        </div>
      </div>
      <div class="px-5 py-8">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
            <div id="studocu-progress-bar" class="h-full bg-blue-600 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <span id="studocu-progress-text" class="text-xs text-slate-500 whitespace-nowrap">0%</span>
        </div>
        <div id="studocu-status" class="text-xs text-slate-400 font-mono">Conectando con Studocu...</div>
      </div>
    </div>
  </div>
</section>

<section id="scribd-preview" class="pb-16 px-6 hidden">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 bg-slate-50">
        <div class="flex items-center gap-2 text-sm text-slate-600">Vista previa del documento</div>
        <a
          id="scribd-download-link"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors"
        >
          Descargar PDF
        </a>
      </div>
      <div class="relative" style="height: 500px;">
        <iframe id="scribd-preview-iframe" class="w-full h-full border-0" sandbox="allow-scripts allow-same-origin"></iframe>
      </div>
    </div>
  </div>
</section>

<section id="slideshare-preview" class="pb-16 px-6 hidden">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-slate-100 bg-slate-50">
        <div class="flex items-center gap-2 text-sm text-slate-600">
          <span id="slideshare-title">SlideShare Presentation</span>
        </div>
        <div class="flex items-center gap-2">
          <button
            id="download-pdf-btn"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            PDF
          </button>
          <button
            id="download-pptx-btn"
            class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            PPTX
          </button>
        </div>
      </div>
      <div id="slideshare-progress" class="px-5 py-4">
        <div class="flex items-center gap-3 mb-3">
          <div class="flex-1 bg-slate-100 rounded-full h-2 overflow-hidden">
            <div id="progress-bar" class="h-full bg-blue-600 rounded-full transition-all duration-300" style="width: 0%"></div>
          </div>
          <span id="progress-text" class="text-xs text-slate-500 whitespace-nowrap">0 / 0</span>
        </div>
        <div id="slide-list" class="max-h-48 overflow-y-auto space-y-1 text-xs font-mono text-slate-500"></div>
      </div>
      <div id="slideshare-grid" class="hidden px-5 pb-5">
        <div id="slide-thumbnails" class="grid grid-cols-3 sm:grid-cols-4 gap-2"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import jsPDF from "jspdf";
  import PptxGenJS from "pptxgenjs";

  const input = document.getElementById("url-input") as HTMLInputElement;
  const btn = document.getElementById("download-btn") as HTMLButtonElement;
  const errorMsg = document.getElementById("error-msg") as HTMLElement;
  const scribdPreview = document.getElementById("scribd-preview") as HTMLElement;
  const scribdIframe = document.getElementById("scribd-preview-iframe") as HTMLIFrameElement;
  const scribdDownloadLink = document.getElementById("scribd-download-link") as HTMLAnchorElement;
  const slidesharePreview = document.getElementById("slideshare-preview") as HTMLElement;
  const slideshareTitle = document.getElementById("slideshare-title") as HTMLElement;
  const progressBar = document.getElementById("progress-bar") as HTMLElement;
  const progressText = document.getElementById("progress-text") as HTMLElement;
  const slideList = document.getElementById("slide-list") as HTMLElement;
  const slideThumbnails = document.getElementById("slide-thumbnails") as HTMLElement;
  const slideshareGrid = document.getElementById("slideshare-grid") as HTMLElement;
  const downloadPdfBtn = document.getElementById("download-pdf-btn") as HTMLButtonElement;
  const downloadPptxBtn = document.getElementById("download-pptx-btn") as HTMLButtonElement;
  const studocuPreview = document.getElementById("studocu-preview") as HTMLElement;
  const studocuTitle = document.getElementById("studocu-title") as HTMLElement;
  const studocuProgressBar = document.getElementById("studocu-progress-bar") as HTMLElement;
  const studocuProgressText = document.getElementById("studocu-progress-text") as HTMLElement;
  const studocuStatus = document.getElementById("studocu-status") as HTMLElement;

  let currentSlideImages: string[] = [];

  function isScribdUrl(url: string): boolean {
    return /scribd\.com/.test(url);
  }

  function isSlideShareUrl(url: string): boolean {
    return /slideshare\.(net|com)/.test(url);
  }

  function isStudocuUrl(url: string): boolean {
    return /studocu\.com/.test(url);
  }

  function extractScribdId(url: string): string | null {
    const match = url.match(/scribd\.com\/(?:document|doc|presentation|embeds|book|audiobook)\/(\d+)/);
    return match ? match[1] : null;
  }

  function resetAll() {
    errorMsg.classList.add("hidden");
    scribdPreview.classList.add("hidden");
    slidesharePreview.classList.add("hidden");
    studocuPreview.classList.add("hidden");
    slideList.innerHTML = "";
    slideThumbnails.innerHTML = "";
    slideshareGrid.classList.add("hidden");
    progressBar.style.width = "0%";
    progressText.textContent = "0 / 0";
    studocuProgressBar.style.width = "0%";
    studocuProgressText.textContent = "0%";
    studocuStatus.textContent = "Conectando con Studocu...";
    currentSlideImages = [];
    downloadPdfBtn.disabled = true;
    downloadPptxBtn.disabled = true;
  }

  function handleScribd(docId: string) {
    const embedUrl = `https://www.scribd.com/embeds/${docId}/content?start_page=1&view_mode=scroll&show_recommendations=false`;
    scribdIframe.src = embedUrl;
    scribdDownloadLink.href = `https://compress-pdf.vietdreamhouse.com/?fileurl=https://scribd.downloader.tips/pdownload/${docId}/document&title=document`;
    scribdPreview.classList.remove("hidden");
    scribdPreview.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function addSlideRow(label: string, status: string) {
    const row = document.createElement("div");
    row.className = "slide-row flex items-center justify-between py-1 border-b border-slate-50";
    row.innerHTML = `
      <span class="text-slate-700">${label}</span>
      <span class="slide-row-status text-slate-400">${status}</span>
    `;
    slideList.appendChild(row);
  }

  function updateProgress(current: number | string, total: number | string) {
    const pct = total === "?" ? 0 : Math.round((Number(current) / Number(total)) * 100);
    progressBar.style.width = `${pct}%`;
    progressText.textContent = `${current} / ${total}`;
  }

  function showThumbnails(images: string[]) {
    slideThumbnails.innerHTML = "";
    images.slice(0, 12).forEach((src, i) => {
      const img = document.createElement("img");
      img.src = src;
      img.alt = `Slide ${i + 1}`;
      img.className = "w-full h-auto rounded border border-slate-200";
      img.loading = "lazy";
      slideThumbnails.appendChild(img);
    });
    if (images.length > 12) {
      const more = document.createElement("p");
      more.className = "text-xs text-slate-400 text-center col-span-full";
      more.textContent = `+ ${images.length - 12} diapositivas más`;
      slideThumbnails.appendChild(more);
    }
    slideshareGrid.classList.remove("hidden");
  }

  async function handleSlideShare(url: string) {
    slidesharePreview.classList.remove("hidden");
    slideshareTitle.textContent = "Cargando presentación...";
    downloadPdfBtn.disabled = true;
    downloadPptxBtn.disabled = true;

    let fakeSlide = 0;
    const fakeInterval = setInterval(() => {
      fakeSlide++;
      const fakeKB = Math.floor(Math.random() * 150 + 80);
      addSlideRow(`Slide ${fakeSlide}`, `${fakeKB} KB`);
      updateProgress(fakeSlide, "?");
    }, 300);

    try {
      const fetchRes = await fetch("/api/fetch", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url }),
      });
      clearInterval(fakeInterval);

      if (!fetchRes.ok) {
        const err = await fetchRes.json();
        slideList.innerHTML = `<p class="text-red-500">${err.error || "Error al cargar la presentación"}</p>`;
        return;
      }

      const data = await fetchRes.json();
      slideshareTitle.textContent = data.title || "SlideShare Presentation";
      currentSlideImages = data.images;
      const total = data.totalSlides;
      slideList.innerHTML = "";
      for (let i = 0; i < total; i++) {
        addSlideRow(`Slide ${i + 1}`, "Cargado");
        updateProgress(i + 1, total);
      }

      slideshareTitle.textContent = `Descargando ${total} diapositivas...`;
      const downloadRes = await fetch("/api/download", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ url, images: data.images }),
      });

      if (!downloadRes.ok) {
        const err = await downloadRes.json();
        slideList.innerHTML += `<p class="text-red-500 mt-2">${err.error || "Error al descargar imágenes"}</p>`;
        return;
      }

      const downloadData = await downloadRes.json();
      currentSlideImages = downloadData.images.map((img: { data: string }) => img.data);
      slideList.querySelectorAll(".slide-row-status").forEach((row) => {
        row.textContent = "Listo ✓";
      });
      slideshareTitle.textContent = `${data.title} — ${total} diapositivas listas`;
      downloadPdfBtn.disabled = false;
      downloadPptxBtn.disabled = false;
      showThumbnails(currentSlideImages);
    } catch {
      clearInterval(fakeInterval);
      slideList.innerHTML = `<p class="text-red-500">Error de conexión. Intenta de nuevo.</p>`;
    }
  }

  async function generatePdf() {
    if (currentSlideImages.length === 0) return;
    downloadPdfBtn.disabled = true;
    downloadPdfBtn.textContent = "Generando...";
    try {
      const doc = new jsPDF({ orientation: "landscape", unit: "px", format: "a4" });
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();
      for (let i = 0; i < currentSlideImages.length; i++) {
        if (i > 0) doc.addPage();
        try {
          doc.addImage(currentSlideImages[i], "JPEG", 0, 0, pageWidth, pageHeight);
        } catch {
          /* skip */
        }
      }
      doc.save("slideshare-presentation.pdf");
    } catch {
      alert("Error al generar el PDF");
    } finally {
      downloadPdfBtn.disabled = false;
      downloadPdfBtn.textContent = "PDF";
    }
  }

  async function generatePptx() {
    if (currentSlideImages.length === 0) return;
    downloadPptxBtn.disabled = true;
    downloadPptxBtn.textContent = "Generando...";
    try {
      const pptx = new PptxGenJS();
      pptx.defineLayout({ name: "WIDE", width: 13.33, height: 7.5 });
      pptx.layout = "WIDE";
      for (let i = 0; i < currentSlideImages.length; i++) {
        const slide = pptx.addSlide();
        try {
          slide.addImage({ data: currentSlideImages[i], x: 0, y: 0, w: "100%", h: "100%" });
        } catch {
          /* skip */
        }
      }
      await pptx.writeFile({ fileName: "slideshare-presentation.pptx" });
    } catch {
      alert("Error al generar el PPTX");
    } finally {
      downloadPptxBtn.disabled = false;
      downloadPptxBtn.textContent = "PPTX";
    }
  }

  function handleStudocu() {
    studocuPreview.classList.remove("hidden");
    studocuTitle.textContent = "Procesando documento de Studocu...";
    const messages = [
      { t: 0, msg: "Conectando con Studocu..." },
      { t: 2000, msg: "Buscando documento en la base de datos..." },
      { t: 5000, msg: "Documento encontrado, descargando páginas..." },
      { t: 10000, msg: "Descargando página 1 de 12..." },
      { t: 13000, msg: "Descargando página 5 de 12..." },
      { t: 17000, msg: "Descargando página 8 de 12..." },
      { t: 20000, msg: "Descargando página 10 de 12..." },
      { t: 23000, msg: "Descargando página 12 de 12..." },
      { t: 25000, msg: "Generando PDF..." },
      { t: 28000, msg: "Comprimiendo archivo..." },
    ];
    const totalDuration = 30000;
    const startTime = Date.now();
    const progressInterval = setInterval(() => {
      const elapsed = Date.now() - startTime;
      const pct = Math.min(Math.round((elapsed / totalDuration) * 100), 99);
      studocuProgressBar.style.width = `${pct}%`;
      studocuProgressText.textContent = `${pct}%`;
    }, 100);
    messages.forEach(({ t, msg }) => {
      setTimeout(() => {
        studocuStatus.textContent = msg;
      }, t);
    });
    setTimeout(() => {
      clearInterval(progressInterval);
      studocuProgressBar.style.width = "100%";
      studocuProgressText.textContent = "100%";
      studocuStatus.innerHTML = "";
      const unavailable = document.createElement("div");
      unavailable.className = "text-center py-6";
      unavailable.innerHTML = `
        <div class="text-amber-500 text-3xl mb-3">⚠️</div>
        <p class="text-slate-700 font-medium mb-2">El servicio de Studocu no está disponible aún</p>
        <p class="text-sm text-slate-500 max-w-md mx-auto">
          Estamos trabajando para soportar descargas de Studocu.
          Mientras tanto puedes descargar documentos de Scribd y SlideShare.
        </p>
      `;
      const progressArea = studocuPreview.querySelector(".px-5.py-8");
      if (progressArea) {
        progressArea.innerHTML = "";
        progressArea.appendChild(unavailable);
      }
    }, totalDuration);
    studocuPreview.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  async function handleDownload() {
    const url = input.value.trim();
    resetAll();
    if (!url) {
      input.focus();
      return;
    }
    if (isScribdUrl(url)) {
      const docId = extractScribdId(url);
      if (!docId) {
        errorMsg.classList.remove("hidden");
        return;
      }
      handleScribd(docId);
    } else if (isSlideShareUrl(url)) {
      await handleSlideShare(url);
    } else if (isStudocuUrl(url)) {
      handleStudocu();
    } else {
      errorMsg.classList.remove("hidden");
    }
  }

  btn.addEventListener("click", handleDownload);
  downloadPdfBtn.addEventListener("click", generatePdf);
  downloadPptxBtn.addEventListener("click", generatePptx);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter") handleDownload();
  });
  input.addEventListener("input", () => {
    errorMsg.classList.add("hidden");
  });
</script>
