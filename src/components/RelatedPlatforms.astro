---
import { platforms, type PlatformId } from "../data/platforms";

interface Props {
  current: PlatformId | "home";
}

const { current } = Astro.props;
const items = platforms.filter((p) => p.id !== current).slice(0, 3);
---

<section class="py-16 px-6">
  <div class="max-w-3xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-blue-600">También puedes usar</p>
    <h2 class="mt-2 text-2xl font-bold text-slate-900">Otras páginas de Descarga Script</h2>
    <p class="mt-2 text-sm text-slate-500 max-w-2xl">
      Si ya tienes el enlace, entra a la página de la plataforma y descarga sin volver a buscar en Google.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-3">
      {items.map((p) => (
        <a
          href={p.href}
          class="rounded-2xl border border-slate-200 bg-white p-5 transition hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-md"
        >
          <div class="text-2xl">{p.emoji}</div>
          <h3 class="mt-3 text-lg font-semibold text-slate-900">{p.name}</h3>
          <p class="mt-2 text-sm text-slate-500">{p.blurb}</p>
          <p class="mt-4 text-sm font-semibold text-blue-600">Abrir {p.name} →</p>
        </a>
      ))}
    </div>
  </div>
</section>
